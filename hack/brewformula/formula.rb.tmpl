# Written by the release workflow of {{.Homepage}}
# with its hack/brewformula, for each release: change that, not this.
class KubectlNapwake < Formula
  desc "Find idle Kubernetes workloads, and pause and wake them with Napwake"
  homepage "{{.Homepage}}"
  version "{{.Version}}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "{{.MacARM.URL}}"
      sha256 "{{.MacARM.SHA256}}"
    end
    on_intel do
      url "{{.MacIntel.URL}}"
      sha256 "{{.MacIntel.SHA256}}"
    end
  end

  on_linux do
    on_arm do
      url "{{.LinuxARM.URL}}"
      sha256 "{{.LinuxARM.SHA256}}"
    end
    on_intel do
      url "{{.LinuxIntel.URL}}"
      sha256 "{{.LinuxIntel.SHA256}}"
    end
  end

  def install
    bin.install Dir["kubectl-napwake-*"].first => "kubectl-napwake"
  end

  test do
    assert_match "kubectl-napwake v#{version}", shell_output("#{bin}/kubectl-napwake version")
  end
end
