---
// Where to go next: link cards, with the doorman pointing the way ("This way": getting started, next
// steps). Outside documentation steps, at the end of a page.
import Doorman from './Doorman.astro';
import { link } from './lib';
interface Props { items: { href: string; title: string; text: string }[]; title?: string; doorman?: boolean }
const { items, title = 'Next', doorman = true } = Astro.props;
---
<section class:list={['nw-next', 'not-content', doorman && 'nw-next--doorman']} aria-label={title}>
  {doorman && <Doorman pose="point" class="nw-next__doorman" />}
  <div class="nw-next__list">
    {title && <p class="nw-next__title">{title}</p>}
    <ul>
      {items.map((it) => (
        <li><a href={link(it.href)}><span class="nw-next__name">{it.title} <span aria-hidden="true">→</span></span><span class="nw-next__text" set:html={it.text} /></a></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .nw-next { margin-top: 2.5rem; display: grid; gap: 1rem 1.5rem; align-items: end; }
  .nw-next--doorman { grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr); }
  .nw-next__doorman { width: 100%; max-width: 7.5rem; align-self: end; }
  .nw-next__title { margin: 0 0 0.6rem; font: 700 0.75rem/1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 0.75rem; }
  li { margin: 0 !important; }
  a { display: flex; flex-direction: column; gap: 0.25rem; height: 100%; box-sizing: border-box; padding: 0.9rem 1rem 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); text-decoration: none; color: var(--text); transition: border-color var(--duration-ui-short) var(--ease-calm); }
  a:hover { border-color: var(--action); }
  .nw-next__name { font: 700 1rem/1.35 var(--font-sans); }
  .nw-next__name span { color: var(--muted); }
  a:hover .nw-next__name span { color: var(--link); }
  .nw-next__text { font-size: 0.875rem; line-height: 1.5; color: var(--muted); }
  @media (max-width: 40rem) { .nw-next--doorman { grid-template-columns: 1fr; } .nw-next__doorman { max-width: 5.5rem; } }
</style>
