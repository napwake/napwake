---
// Where a setting comes from, in the order it's read: the first that can be read wins.
interface Props { items: { title: string; text?: string }[]; label: string }
const { items, label } = Astro.props;
---
<ol class="nw-prec not-content" aria-label={label}>
  {items.map((it, i) => (
    <li>
      <span class="nw-prec__n">{i + 1}</span>
      <span class="nw-prec__title" set:html={it.title} />
      {it.text && <span class="nw-prec__text" set:html={it.text} />}
    </li>
  ))}
</ol>
<style>
  .nw-prec { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr)); gap: 0.6rem; }
  li { position: relative; margin: 0 !important; padding: 0.75rem 0.85rem 0.85rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); display: flex; flex-direction: column; gap: 0.3rem; }
  li:not(:last-child)::after { content: '→'; position: absolute; right: -0.62rem; top: 50%; transform: translateY(-50%); z-index: 1; width: 1.1rem; height: 1.1rem; display: grid; place-items: center; font-size: 0.75rem; line-height: 1; color: var(--muted); background: var(--bg); border-radius: 50%; }
  .nw-prec__n { font: 700 0.6875rem/1 var(--font-mono); color: var(--brand); }
  .nw-prec__title { font: 700 0.9375rem/1.3 var(--font-sans); color: var(--text); }
  .nw-prec__title :global(code) { font: 700 0.85em var(--font-mono); background: var(--code-bg); padding: 0.05em 0.3em; border-radius: var(--radius-sm); }
  .nw-prec__text { font-size: 0.8125rem; line-height: 1.45; color: var(--muted); }
  .nw-prec__text :global(code) { font: 400 0.9em var(--font-mono); }
  @media (max-width: 40rem) { li:not(:last-child)::after { content: '↓'; right: auto; left: 50%; top: auto; bottom: -0.62rem; transform: translateX(-50%); } }
</style>
